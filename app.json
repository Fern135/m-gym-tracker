{
  "expo": {
    "name": "Ironweek",
    "slug": "ironweek",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fernandocamblor.ironweek"
    },
    "android": {
      "package": "com.fernandocamblor.ironweek",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ironweek lets you pick exercise videos from your library.",
          "cameraPermission": "Ironweek uses the camera to record how-to videos for your exercises.",
          "microphonePermission": "Recording a video captures sound; Ironweek plays exercise videos muted."
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/rest_classic.wav",
            "./assets/sounds/rest_digital.wav",
            "./assets/sounds/rest_rising.wav",
            "./assets/sounds/rest_bell.wav",
            "./assets/sounds/reminder_chime.wav",
            "./assets/sounds/reminder_marimba.wav"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#E9ECEA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#1A1D20"
          }
        }
      ]
    ],
    "scheme": "ironweek",
    "experiments": {
      "typedRoutes": true
    }
  }
}
